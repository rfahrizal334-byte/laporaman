# Salin file ini menjadi .env lalu isi nilainya.

PORT=3000

# Connection string PostgreSQL. Contoh Supabase/Neon:
# postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://user:password@localhost:5432/laporaman

# Set true untuk Supabase/Neon atau provider yang mewajibkan SSL.
# Set false untuk PostgreSQL lokal / Render internal database.
PGSSL=false

# Kredensial panel admin. Gunakan password panjang dan unik.
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-dengan-password-yang-sangat-kuat

# Rahasia untuk meng-hash kode tiket. Minimal 16 karakter acak.
# Contoh: openssl rand -hex 32
TICKET_SECRET=ganti-dengan-string-acak-panjang-minimal-16-karakter
